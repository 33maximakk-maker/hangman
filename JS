<!DOCTYPE html>
<html>
<head>
    <title>Hangman - JS</title>
    <style>
        body { background: #2c3e2f; font-family: monospace; color: #deb887; text-align: center; }
        pre { font-size: 14px; background: #1e2a1f; display: inline-block; padding: 10px; }
        .word { font-size: 28px; letter-spacing: 8px; margin: 20px; }
        .guessed { margin: 10px; }
        input { padding: 5px; font-size: 18px; }
        button { margin: 10px; padding: 5px 15px; }
    </style>
</head>
<body>
<h1>Hangman</h1>
<pre id="hangmanPic"></pre>
<div class="word" id="wordDisplay"></div>
<div class="guessed">Guessed letters: <span id="guessedLetters"></span></div>
<div>Attempts left: <span id="attemptsLeft"></span></div>
<input type="text" id="guessInput" maxlength="1" autofocus>
<button id="guessBtn">Guess</button>
<button id="newGameBtn">New Game</button>
<script src="hangman.js"></script>
</body>
</html>
